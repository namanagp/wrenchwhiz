{
  "name": "motorlingo",
  "version": "1.0.0",
  "private": true,
  "description": "Motorlingo - learn your car's language. A car repair companion for beginners and DIYers",
  "type": "module",
  "scripts": {
    "start": "vite build && node server/index.js",
    "serve": "node server/index.js",
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "test": "node scripts/smoke-test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "screenshots:ai": "node scripts/screenshots-ai.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  },
  "license": "MIT",
  "author": "Naman Gupta",
  "repository": {
    "type": "git",
    "url": "https://github.com/namanagp/motorlingo"
  }
}
