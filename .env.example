# Copy to .env and add ONE key to turn on full AI (chat, free-text symptom analysis, custom guides).
# Without a key the app runs fully on its built-in knowledge base.
# Real environment variables (process.env) take precedence over values in .env.

# --- OpenRouter (preferred when set; one key, hundreds of models) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4.1-mini     # any ID from https://openrouter.ai/api/v1/models
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:5180  # sent as HTTP-Referer (app attribution)
# OPENROUTER_APP_NAME=WrenchWhiz             # sent as X-Title

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint works

# --- Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Priority when several keys are set: OpenRouter > OpenAI > Anthropic. Force one with:
# LLM_PROVIDER=openrouter
# PORT=5180
